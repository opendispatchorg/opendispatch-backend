{
  "openapi": "3.1.1",
  "info": {
    "title": "OpenDispatch",
    "description": "The REST half of the OpenDispatch API contract. SignalR board events and the offline-sync payloads are not describable here; they live in @opendispatch/contracts.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "OpenDispatch.Api"
        ],
        "operationId": "Health",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "AuthEndpoints"
        ],
        "operationId": "Login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "required": [
          "status",
          "service"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "service": {
            "type": "string"
          }
        },
        "description": "The payload returned by `GET /health`."
      },
      "LoginRequest": {
        "required": [
          "username",
          "password"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "Whoever is asking."
          },
          "password": {
            "type": "string",
            "description": "Proof it is them."
          }
        },
        "description": "The body of `POST /auth/login`."
      }
    }
  },
  "tags": [
    {
      "name": "OpenDispatch.Api"
    },
    {
      "name": "AuthEndpoints"
    }
  ]
}