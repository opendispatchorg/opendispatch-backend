# Everything a deployment sets, in one place.
#
# Until now this list existed only as prose in the README, which meant the answer to "what do I have
# to set" was "read three sections and hope". Copy this, fill it in, and it is the whole
# configuration surface — every key below maps to a section the host binds and validates at startup,
# so a missing required one is a refusal to start rather than a failure on somebody's first upload.
#
# Double underscores are the .NET convention for nesting: Database__ConnectionString is the
# `ConnectionString` key of the `Database` section.

# ── Required. The host refuses to start outside Development without these ──────────────────────

# Postgres. A `postgres://` URL (what Render, Fly, Heroku, Supabase and Neon hand you) or an Npgsql
# key-value string. Pool sizing belongs here: Maximum Pool Size at or below what the database will
# grant across every instance, Minimum Pool Size=2, Timeout=15.
Database__ConnectionString=postgres://user:password@host:5432/opendispatch

# Signs every token. `openssl rand -base64 48`. Changing it signs everybody out at once.
Jwt__SigningKey=

# ── Attachments. Required on any platform with an ephemeral container filesystem ───────────────
#
# Naming a bucket turns on object storage; leaving it blank stores photographs on the disk at
# Attachments__Root. On Render, Fly, Cloud Run and anything else that hands each release a fresh
# disk, the bucket is mandatory: a deploy would otherwise destroy every photograph and signature
# captured since the last one, silently.
#
# The bucket must already exist, and it must NOT have versioning or object-lock retention turned on
# — erasure deletes a photograph, and a versioned bucket only hides it.
Attachments__Bucket=
Attachments__ServiceUrl=https://<accountid>.r2.cloudflarestorage.com
Attachments__Region=auto

# Credentials have no configuration key by design: the S3 client reads them from the environment, so
# there is nowhere for one to be typed into a committed file.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# On a disk instead. Mount a volume over it and back it up with the database.
# Attachments__Root=/var/lib/opendispatch/attachments

# ── Strongly recommended in production ─────────────────────────────────────────────────────────

ASPNETCORE_ENVIRONMENT=Production

# The port the container binds. The image already sets 8080; platforms that inject PORT want it to
# agree.
PORT=8080

# Newline-delimited JSON to stdout, so a log pipeline parses properties rather than sentences.
Logging__Json=true

# Read X-Forwarded-For / -Proto. Turn on ONLY when this host is unreachable except through the
# proxy. Without it every request appears to come from the proxy over plain HTTP: the login rate
# limiter partitions the whole internet into one bucket, and HSTS is never sent.
ReverseProxy__Enabled=true

# The browser origins allowed to call the API and the hub. With none set, no browser client can.
Cors__Origins__0=https://board.yourshop.example
# Cors__Origins__1=https://field.yourshop.example

# ── Optional. Each does nothing at all until set ───────────────────────────────────────────────

# Customer notifications over SMTP: "your technician is on the way", and a receipt when an invoice
# is settled. No Mail__Host means nothing is sent and nothing fails.
Mail__Host=
Mail__Port=587
Mail__From=dispatch@yourshop.example
Mail__FromName=Your Shop
Mail__Username=
Mail__Password=

# The SignalR backplane. Required for more than one API instance: without it the live board is
# correct only while there is exactly one, silently.
SignalR__Redis=

# An OTLP collector for metrics and traces. A collector that is down costs nothing.
Otel__Endpoint=
Otel__Protocol=grpc
Otel__ServiceName=opendispatch-api

# Caps. All three are on by default; these are the numbers, not switches.
# RateLimit__PermitLimit=20
# RateLimit__WindowSeconds=300
# RateLimit__PushesPerMinute=60
# RateLimit__OptimizationsPerMinute=10

# How much of a technician's change stream one /sync/pull may carry.
# Sync__PullPageTransactions=200
# Sync__PullPageRows=2000

# The outbox sweep. Turning it off is an incident measure, not a configuration.
# Outbox__Enabled=true
# Outbox__IntervalSeconds=10
# Outbox__GraceSeconds=30
# Outbox__BatchSize=50
