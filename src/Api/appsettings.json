{
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Attachments": {
    "Root": "attachments"
  },
  "Database": {
    "ConnectionString": "Host=localhost;Port=5433;Database=opendispatch;Username=opendispatch;Password=opendispatch"
  }
}
