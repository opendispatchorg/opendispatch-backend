<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    OpenAPI document generation at build time rather than from a running host, so the REST
    half of the contract can be exported without booting a server or picking a port. Off by
    default: `make gen-contracts` turns it on, which keeps the export an explicit act and the
    ordinary build (and the test loop) free of it.

    The document lands in obj/ under a name the tooling derives from the project. Nothing but
    `make gen-contracts` reads it, and it is that target which copies it into contracts/ as
    openapi.json — so everything in the published package is put there deliberately.
  -->
  <PropertyGroup>
    <OpenApiGenerateDocuments>false</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildThisFileDirectory)obj\openapi</OpenApiDocumentsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.11" />
    <!--
      Microsoft.AspNetCore.OpenApi 10.0.10 resolves Microsoft.OpenApi 2.0.0 transitively, and
      that version carries GHSA-v5pm-xwqc-g5wc. NuGet audit reports it, warnings are errors,
      and the build stops — which is the gate working. 2.7.5 is the first release without the
      advisory. Drop this line once the framework package resolves a patched version itself.
    -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!--
      Design-time only, and referenced here rather than in Infrastructure because `dotnet ef`
      wants it on the startup project — the one that can build a host and hand it a configured
      connection string. It is a development dependency, so nothing flows into the published app.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <!--
      JWT bearer auth (Document 2 §7, step 44). Not part of the Microsoft.AspNetCore.App shared
      framework this Sdk already references — unlike cookie auth, the JWT handler has always
      shipped as its own package because of the Microsoft.IdentityModel.* dependency chain it
      carries.
    -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The integration suite reaches two internals directly: the exception handler's decision about
      what a client disconnect is, and the correlation-id middleware. Both are edge behaviour with
      no HTTP surface of their own — a disconnected request has nobody left to answer — so testing
      them through a request would mean testing the test harness's ability to hang up. The same
      arrangement Scheduling has with its own tests.
    -->
    <InternalsVisibleTo Include="OpenDispatch.Api.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\Application.csproj" />
    <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
    <ProjectReference Include="..\Domain\Domain.csproj" />
    <ProjectReference Include="..\Contracts\Contracts.csproj" />
  </ItemGroup>

</Project>
