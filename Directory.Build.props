<Project>

  <!--
    Repo-wide build settings. Every project under src/ and tests/ imports this file
    automatically, so individual .csproj files declare only what is genuinely
    project-specific (OutputType, IsPackable, package and project references).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    Assembly and namespace identity. Directories are unprefixed (src/Domain,
    tests/Domain.Tests) while the shipped identity stays fully qualified, matching
    the project names in Document 2 section 2. src/Domain builds OpenDispatch.Domain.dll.
  -->
  <PropertyGroup>
    <RootNamespace>OpenDispatch.$(MSBuildProjectName)</RootNamespace>
    <AssemblyName>OpenDispatch.$(MSBuildProjectName)</AssemblyName>
  </PropertyGroup>

  <!--
    Quality gates, locked before the code exists so they apply to everything that
    follows. A warning anywhere fails the build.
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!--
    IDE0005 (unnecessary using directive) is only reported during a command-line
    build when the documentation file is generated. Generating it also turns on
    CS1591 (missing XML comment on a public member), which is not a gate we want.
  -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    A vulnerable transitive package fails the build rather than producing a report
    nobody reads. `all` rather than `direct` on purpose: the advisories that have
    actually bitten this repository arrived transitively — Microsoft.OpenApi through
    the framework's own package at step 22, SSH.NET through Testcontainers — and
    `direct` would have caught neither. Both are pinned forward in the projects that
    resolve them, with the reason written beside the pin.
  -->
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>

  <!--
    Which commit this is. A running container that cannot say what it is makes every
    incident harder: "is the fix deployed" becomes a question about deployment logs
    rather than one the process can answer about itself.

    Version is the human number and is bumped by hand. SourceRevisionId is filled by
    CI with the commit SHA (`-p:SourceRevisionId=$GITHUB_SHA`) and left as `local`
    otherwise, which is the honest answer for a build off somebody's working tree —
    it may contain anything. The SDK appends SourceRevisionId to
    InformationalVersion as `+<value>`, so one attribute carries both and
    BuildVersion reads it back at startup.
  -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <SourceRevisionId Condition="'$(SourceRevisionId)' == ''">local</SourceRevisionId>
  </PropertyGroup>

</Project>
